---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "關於作者 - 顏檸",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<div class="flex items-start gap-6">
			<img
				src="/images/author.webp"
				alt="作者頭像"
				class="h-24 w-24 shrink-0 rounded-full object-cover shadow-lg"
			/>
			<div>
				<p class="mt-0">
					你好！我是顏檸，一名大學數學教師，畢業於華南師範大學數學專業研究生。
					這個博客用於分享數學知識和教學心得，希望能幫助更多熱愛數學的同學！
				</p>
				<p>主要教授課程：</p>
				<ul class="list-inside list-disc" role="list">
					<li>高等數學</li>
					<li>線性代數</li>
					<li>概率論與數理統計</li>
				</ul>
			</div>
		</div>
	</div>
</PageLayout>
