---
import fs from "node:fs";
import path from "node:path";
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import Twikoo from "@/components/blog/Twikoo.astro";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;

// Read MDX source file content
const mdxFilePath = path.join(process.cwd(), "src", "content", "post", `${post.id}.mdx`);
let mdxSource = "";
try {
	mdxSource = fs.readFileSync(mdxFilePath, "utf-8");
} catch (err) {
	console.warn(`Could not read MDX source for ${post.id}:`, err);
}
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
>
	<article class="grow break-words" data-pagefind-body data-mdx-source={mdxSource}>
		<div id="blog-hero" class="mb-12"><Masthead content={post} readingTime={readingTime} /></div>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start">
			{!!headings.length && <TOC headings={headings} />}
			<div
				class="prose prose-sm prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-gray-600 prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
				<slot />
				<WebMentions />
				<Twikoo />
			</div>
		</div>
	</article>
	<button
		class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// only show the scroll to top button when the heading is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>

<script>
	import "@/scripts/latex-copy.ts";
</script>

<!-- 全屏左右對照視圖 -->
<div id="compare-view" class="fixed inset-0 z-[200] hidden bg-zinc-100 dark:bg-zinc-900">
	<!-- 頂部工具欄 -->
	<div class="flex h-12 items-center justify-between bg-zinc-200 px-4 dark:bg-zinc-800">
		<h2 class="text-lg font-bold text-zinc-700 dark:text-zinc-200">左右對照視圖</h2>
		<div class="flex items-center gap-3">
			<label
				class="flex cursor-pointer items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300"
			>
				<input type="checkbox" id="sync-scroll-toggle" checked class="h-4 w-4 accent-green-600" />
				同步滾動
			</label>
			<button
				id="copy-source-btn"
				class="rounded bg-green-600 px-3 py-1.5 text-sm text-white hover:bg-green-700"
			>
				複製源代碼
			</button>
			<button
				id="close-compare-btn"
				class="rounded bg-zinc-500 px-3 py-1.5 text-sm text-white hover:bg-zinc-600"
			>
				關閉 (R)
			</button>
		</div>
	</div>

	<!-- 左右分欄 -->
	<div class="flex h-[calc(100vh-3rem)]">
		<!-- 左側：渲染內容 -->
		<div
			id="left-panel"
			class="w-1/2 overflow-auto border-r border-zinc-300 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800"
		>
			<div id="rendered-content" class="prose prose-sm dark:prose-invert max-w-none"></div>
		</div>

		<!-- 右側：源代碼 -->
		<div id="right-panel" class="w-1/2 overflow-auto bg-zinc-900 p-4">
			<pre id="source-content" class="text-sm leading-relaxed whitespace-pre-wrap text-zinc-100">
			</pre>
		</div>
	</div>
</div>

<script>
	const article = document.querySelector("[data-mdx-source]") as HTMLElement;
	const compareView = document.getElementById("compare-view") as HTMLDivElement;
	const renderedContent = document.getElementById("rendered-content") as HTMLDivElement;
	const sourceContent = document.getElementById("source-content") as HTMLPreElement;
	const closeBtn = document.getElementById("close-compare-btn") as HTMLButtonElement;
	const copyBtn = document.getElementById("copy-source-btn") as HTMLButtonElement;
	const leftPanel = document.getElementById("left-panel") as HTMLDivElement;
	const rightPanel = document.getElementById("right-panel") as HTMLDivElement;
	const syncToggle = document.getElementById("sync-scroll-toggle") as HTMLInputElement;

	if (article && compareView && renderedContent && sourceContent && leftPanel && rightPanel) {
		const mdxSource = article.dataset.mdxSource || "";

		let isCompareMode = false;
		let isSyncing = false;
		let syncEnabled = true;
		let lastScrollTime = 0;
		const THROTTLE_MS = 16; // ~60fps

		// 節流的同步滾動功能
		function syncScroll(source: HTMLElement, target: HTMLElement) {
			if (!syncEnabled || isSyncing) return;

			const now = Date.now();
			if (now - lastScrollTime < THROTTLE_MS) return;
			lastScrollTime = now;

			isSyncing = true;

			const sourceMaxScroll = source.scrollHeight - source.clientHeight;
			const targetMaxScroll = target.scrollHeight - target.clientHeight;

			if (sourceMaxScroll > 0 && targetMaxScroll > 0) {
				const ratio = source.scrollTop / sourceMaxScroll;
				target.scrollTop = ratio * targetMaxScroll;
			}

			requestAnimationFrame(() => {
				isSyncing = false;
			});
		}

		leftPanel.addEventListener("scroll", () => syncScroll(leftPanel, rightPanel));
		rightPanel.addEventListener("scroll", () => syncScroll(rightPanel, leftPanel));

		// 同步開關
		syncToggle?.addEventListener("change", () => {
			syncEnabled = syncToggle.checked;
		});

		function toggleCompareMode() {
			isCompareMode = !isCompareMode;

			if (isCompareMode) {
				// 複製整個文章內容（包括標題和日期，但排除評論）
				const blogHero = article.querySelector("#blog-hero");
				const proseContent = article.querySelector(".prose");

				let contentHtml = "";
				if (blogHero) {
					contentHtml += blogHero.outerHTML;
				}
				if (proseContent) {
					// 克隆 prose 內容並移除評論相關元素
					const clonedProse = proseContent.cloneNode(true) as HTMLElement;
					// 移除 Twikoo 評論
					clonedProse.querySelector("#twikoo-container")?.parentElement?.remove();
					// 移除 Webmentions
					clonedProse.querySelectorAll('[class*="webmention"]').forEach((el) => el.remove());
					contentHtml += clonedProse.outerHTML;
				}
				renderedContent.innerHTML = contentHtml;
				sourceContent.textContent = mdxSource;
				compareView.classList.remove("hidden");
				document.body.style.overflow = "hidden";
				// 重置滾動位置
				leftPanel.scrollTop = 0;
				rightPanel.scrollTop = 0;
			} else {
				compareView.classList.add("hidden");
				document.body.style.overflow = "";
			}
		}

		async function copySource() {
			try {
				await navigator.clipboard.writeText(mdxSource);
				if (copyBtn) {
					const originalText = copyBtn.textContent;
					copyBtn.textContent = "已複製 ✓";
					copyBtn.classList.remove("bg-green-600", "hover:bg-green-700");
					copyBtn.classList.add("bg-green-700");
					setTimeout(() => {
						copyBtn.textContent = originalText;
						copyBtn.classList.add("bg-green-600", "hover:bg-green-700");
						copyBtn.classList.remove("bg-green-700");
					}, 2000);
				}
			} catch (err) {
				console.error("Failed to copy:", err);
			}
		}

		// 按 R 鍵切換對照模式（不能有修飾鍵）
		document.addEventListener("keydown", (e) => {
			if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {
				return;
			}

			// 忽略有修飾鍵的情況（Cmd+R, Ctrl+R 等）
			if (e.metaKey || e.ctrlKey || e.altKey) {
				return;
			}

			if (e.key.toLowerCase() === "r") {
				toggleCompareMode();
			}
		});

		closeBtn?.addEventListener("click", () => {
			if (isCompareMode) toggleCompareMode();
		});
		copyBtn?.addEventListener("click", copySource);
	}
</script>
